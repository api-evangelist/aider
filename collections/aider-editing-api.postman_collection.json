          "name": "Aider Request Code Edit",
          "request": {
            "name": "Aider Request Code Edit",
            "description": {
              "content": "Ask for changes to your code. Maps to the `/code` in-chat command (also the default mode behavior).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "commands",
                "code"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
