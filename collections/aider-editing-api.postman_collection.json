                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"<string>\",\n  \"edit_format\": \"<string>\",\n  \"auto_commit\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
