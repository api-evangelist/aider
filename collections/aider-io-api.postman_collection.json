          "name": "Aider Run Shell Command",
          "request": {
            "name": "Aider Run Shell Command",
            "description": {
              "content": "Run a shell command and optionally add output to chat. Maps to `/run`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "commands",
                "run"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"command\": \"<string>\",\n  \"add_output_to_chat\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
